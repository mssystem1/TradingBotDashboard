# Generate a unique random passphrase of at least 32 characters.
DASHBOARD_PASSWORD=
# Exact HTTPS URL used for the private dashboard and Telegram webhook.
APP_ORIGIN=

# Vercel Private Blob linked to the Vercel project.
BLOB_READ_WRITE_TOKEN=

# All AI calls are disabled unless explicitly enabled.
ENABLE_MANUAL_MODEL=false
ENABLE_SCHEDULED_MODEL=false
AI_GATEWAY_API_KEY=
ALERT_COIN=BTC
ALERT_MAX_CALLS_PER_DAY=24

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
# Generate a different value of at least 32 characters. Set the same value
# in Vercel and the GitHub Actions repository secret.
ALERT_JOB_SECRET=
